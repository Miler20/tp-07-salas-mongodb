<section>
  <p class="etiqueta">
    <%= seccion %>
  </p>

  <h1>
    <%= titulo %>
  </h1>

  <p>
    <a class="boton" href="/reservas/nueva">
      Nueva reserva
    </a>
  </p>

  <% if (reservas.length === 0) { %>

    <p>No hay reservas registradas.</p>

  <% } else { %>

    <div class="grilla">

      <% reservas.forEach((reserva) => { %>

        <article class="tarjeta">
          <h2><%= reserva.estudiante %></h2>

          <p>
            <strong>Sala:</strong>
            <%= reserva.sala %>
          </p>

          <p>
            <strong>Fecha:</strong>
            <%= reserva.fecha %>
          </p>

          <p>
            <strong>Turno:</strong>
            <%= reserva.turno %>
          </p>

          <p>
            <strong>Personas:</strong>
            <%= reserva.personas %>
          </p>

          <a href="/reservas/<%= reserva.id %>">
            Ver detalle
          </a>
        </article>

      <% }) %>

    </div>

  <% } %>
</section>